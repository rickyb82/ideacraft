<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>IdeaCraft</string>
  <key>CFBundleName</key>
  <string>IdeaCraft</string>
  <key>CFBundleExecutable</key>
  <string>IdeaCraft</string>
  <key>CFBundleIdentifier</key>
  <string>it.siriuslabs.ideacraft</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>IdeaCraftVersion</key>
  <string>@VERSION@</string>
  <key>IdeaCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>IdeaCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the IdeaCraft contributors. MIT OR Apache-2.0.</string>

  <!-- IdeaCraft's own map type (`.ideacraft`, plain JSON; crates/formats `Format::IdeaCraft`). -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>it.siriuslabs.ideacraft.map</string>
      <key>UTTypeDescription</key>
      <string>IdeaCraft Map</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.json</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>ideacraft</string>
        </array>
      </dict>
    </dict>
  </array>

  <!-- Documents IdeaCraft opens: its own maps, and the formats it imports as an alternative
       handler (never the default for them). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>IdeaCraft Map</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>it.siriuslabs.ideacraft.map</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Mind map or diagram</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>mm</string>
        <string>xmind</string>
        <string>cxl</string>
        <string>opml</string>
        <string>drawio</string>
        <string>mmd</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
